# Raw data snapshot IS committed (data/raw/*.csv); generated data is not
data/processed/*
!data/processed/.gitkeep
*.parquet
reports/*.csv

# Generated reports
reports/figures/*
!reports/figures/.gitkeep

# Working copy of the presentation (published as a Claude artifact)
_deck/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Jupyter
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
